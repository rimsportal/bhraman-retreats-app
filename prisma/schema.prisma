generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String    @id @default(cuid())
  externalId String?   @unique
  email      String    @unique
  name       String?
  phone      String?
  role       String    @default("GUEST")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  bookings   Booking[]
}

model AdminUser {
  id                 String    @id @default(cuid())
  username           String    @unique
  passwordHash       String
  salt               String
  role               String    @default("SUPER_ADMIN")
  mustChangePassword Boolean   @default(true)
  mfaSecret          String?
  mfaEnabled         Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([username])
}

model Retreat {
  id                String       @id @default(cuid())
  slug              String       @unique
  title             String
  edition           String?
  summary           String
  description       String
  location          String
  venue             String?
  startDate         DateTime
  endDate           DateTime
  priceInPaise      Int
  capacity          Int
  status            String       @default("UPCOMING")
  heroImageUrl      String?
  highlight         String?
  storyTitle        String?
  storyBody         String?
  participantCount  Int?
  displayOrder      Int          @default(0)
  coverMediaId      String?
  publicationStatus String       @default("DRAFT")
  publishedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  bookings          Booking[]
  enquiries         Enquiry[]
  itinerary         RetreatDay[]
  media             MediaAsset[]

  @@index([publicationStatus, status, startDate])
  @@index([status, publicationStatus, displayOrder])
}

model RetreatDay {
  id                String             @id(map: "ItineraryDay_pkey") @default(cuid())
  retreatId         String
  dayNumber         Int
  element           String
  title             String
  description       String?
  legacyActivities  String?            @map("activities")
  publicationStatus String             @default("DRAFT")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt
  sections          ItinerarySection[]
  retreat           Retreat            @relation(fields: [retreatId], references: [id], onDelete: Cascade)

  @@unique([retreatId, dayNumber])
  @@index([retreatId, publicationStatus])
}

model ItinerarySection {
  id                String              @id @default(cuid())
  retreatDayId      String
  title             String
  description       String?
  sortOrder         Int                 @default(0)
  publicationStatus String              @default("DRAFT")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  activities        ItineraryActivity[]
  retreatDay        RetreatDay          @relation(fields: [retreatDayId], references: [id], onDelete: Cascade)

  @@index([retreatDayId, sortOrder])
}

model ItineraryActivity {
  id                 String           @id @default(cuid())
  itinerarySectionId String
  title              String
  description        String?
  startTime          String?
  sortOrder          Int              @default(0)
  publicationStatus  String           @default("DRAFT")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  itinerarySection   ItinerarySection @relation(fields: [itinerarySectionId], references: [id], onDelete: Cascade)

  @@index([itinerarySectionId, sortOrder])
}

model Booking {
  id            String   @id @default(cuid())
  reference     String   @unique
  userId        String
  retreatId     String
  guests        Int      @default(1)
  totalInPaise  Int
  status        String   @default("PENDING")
  paymentStatus String   @default("PENDING")
  dietaryNotes  String?
  healthNotes   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  retreat       Retreat  @relation(fields: [retreatId], references: [id])
  user          User     @relation(fields: [userId], references: [id])
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  published Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model MediaAsset {
  id                String    @id @default(cuid())
  blobName          String    @unique
  url               String
  altText           String
  mimeType          String
  width             Int?
  height            Int?
  title             String?
  caption           String?
  credit            String?
  category          String?
  retreatId         String?
  displayOrder      Int       @default(0)
  isCover           Boolean   @default(false)
  isFeatured        Boolean   @default(false)
  thumbnailUrl      String?
  posterUrl         String?
  publicationStatus String    @default("DRAFT")
  kind              String    @default("IMAGE")
  folder            String    @default("legacy")
  originalFileName  String?
  sizeBytes         Int?
  durationSeconds   Int?
  uploadStatus      String    @default("AUTHORIZED")
  etag              String?
  uploadedAt        DateTime?
  publishedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  retreat           Retreat?  @relation(fields: [retreatId], references: [id], onDelete: SetNull)

  @@index([publicationStatus, folder, createdAt])
  @@index([uploadStatus, createdAt])
  @@index([retreatId, publicationStatus, displayOrder])
}

model Testimonial {
  id                String    @id @default(cuid())
  slug              String    @unique
  name              String
  location          String?
  quote             String
  sortOrder         Int       @default(0)
  publicationStatus String    @default("DRAFT")
  publishedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  imageUrl          String?

  @@index([publicationStatus, sortOrder])
}

model BlogPost {
  id                String    @id @default(cuid())
  slug              String    @unique
  title             String
  excerpt           String
  content           String
  coverImageUrl     String?
  authorName        String?
  publicationStatus String    @default("DRAFT")
  publishedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([publicationStatus, publishedAt])
}

model FounderProfile {
  id                String    @id @default(cuid())
  slug              String    @unique
  name              String
  title             String
  bio               String
  imageUrl          String?
  credentials       String?
  publicationStatus String    @default("DRAFT")
  publishedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([publicationStatus])
}

model Quote {
  id                String    @id @default(cuid())
  slug              String    @unique
  text              String
  attribution       String?
  context           String?
  sortOrder         Int       @default(0)
  publicationStatus String    @default("DRAFT")
  publishedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([publicationStatus, sortOrder])
}

model SiteSetting {
  id                String    @id @default(cuid())
  key               String    @unique
  value             Json
  description       String?
  publicationStatus String    @default("DRAFT")
  publishedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([publicationStatus])
}

model Enquiry {
  id        String   @id @default(cuid())
  retreatId String?
  name      String
  email     String
  phone     String?
  message   String
  status    String   @default("NEW")
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  retreat   Retreat? @relation(fields: [retreatId], references: [id])

  @@index([status, createdAt])
  @@index([retreatId])
}
